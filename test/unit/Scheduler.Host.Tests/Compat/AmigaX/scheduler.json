{
  "project": "AmigaX",
  "slots": 3,
  "jobsDir": "docs/jobs",
  "remote": "origin",
  "branch": "main",
  "workspaceRoot": "C:\\Projects\\AmigaX-workspaces",
  "port": 8765,
  "listen": "lan",
  "remoteControl": true,
  "page": { "theme": "docs/jobs/scheduler-theme.json" },
  "planner": { "outbox": "docs\\jobs\\.planner-outbox", "fetchRepo": "C:\\Projects\\AmigaX" },
  "jobsEnvVar": "AMIGAX_JOBS",
  "workerWindow": "Hidden",
  "worker": {
    "cli": "copilot",
    "args": ["-p", "{prompt}", "--allow-all", "--no-ask-user", "--output-format=json", "--disable-builtin-mcps", "--model={model}"],
    "model": "spark",
    "endpoint": "http://spark.local:18400/v1",
    "metricsUrl": "http://spark.local:18400/metrics",
    "env": {
      "COPILOT_PROVIDER_BASE_URL": "{endpoint}",
      "COPILOT_PROVIDER_TYPE": "openai",
      "COPILOT_MODEL": "{model}",
      "COPILOT_PROVIDER_MAX_PROMPT_TOKENS": "{contextLength-32768}"
    },
    "quotaPatterns": ["exceeded your (monthly )?quota", "quota exceeded", "rate limit", "AI Credits 0"]
  },
  "agents": {
    "claude": {
      "cli": "claude",
      "args": ["-p", "{prompt}", "--output-format", "stream-json", "--verbose", "--include-partial-messages",
              "--model", "{model}", "--dangerously-skip-permissions"],
      "format": "claude",
      "model": "claude-sonnet-5-5",
      "quotaPatterns": ["usage limit", "rate limit", "rate_limit_error", "credit balance is too low", "Failed to authenticate"]
    }
  },
  "health": {
    "command": "cmake -S platform/null -B build/null -DAMIGAX_UNITTESTS=OFF && cmake --build build/null --config Release --parallel {jobs} && py testplan/tools/runtests.py --gate --jobs {jobs} && py tools/gates.py --only build-null-linux,unittests-linux --jobs {jobs}"
  },
  "promptExtra": "Builds and tests: cmake --build --parallel {jobs}, msbuild /m:{jobs}, runtests.py --jobs {jobs}.",
  "limits": {
    "pollSeconds": 15,
    "maxRetries": 2,
    "stallMinutes": 30,
    "warnMinutes": 20,
    "stopGraceMinutes": 20,
    "maxMinutes": 240
  }
}
