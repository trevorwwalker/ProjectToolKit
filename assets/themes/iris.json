{
  "name": "Iris",
  "label": "Iris",
  "order": 140,
  "extends": "../theme.default.json",
  "description": "Iris violet and lavender.",
  "css": [
    ":root { color-scheme: light; --bg: #5a4fcf; --panel: #ffffff; --text: #1e1a4a; --muted: #5e5a8a; --line: #dcd9f2;",
    "  --accent: #5a4fcf; --accent-text: #eceaff; --ok: #197a42; --warn: #9a5b00; --bad: #c62828; --bar: #eceaff;",
    "  --log-bg: #f6f5fd; --shadow: 0 2px 6px rgba(0, 0, 0, .3); }",
    ".screen { background: #5a4fcf; color: #eceaff; border-bottom: 3px solid #eceaff; }",
    ".bar { color: #5a4fcf; } .bar .tag { color: #5a4fcf; }",
    ".bar button { background: #5a4fcf; color: #eceaff; }"
  ]
}
