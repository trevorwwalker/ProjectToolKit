{
  "name": "LAFC",
  "label": "LAFC",
  "order": 150,
  "extends": "../theme.default.json",
  "description": "Black and gold.",
  "css": [
    ":root { color-scheme: light; --bg: #000000; --panel: #ffffff; --text: #1a1a1a; --muted: #5f5f5f; --line: #e4ddd0;",
    "  --accent: #000000; --accent-text: #c39e6d; --ok: #197a42; --warn: #9a5b00; --bad: #c62828; --bar: #c39e6d;",
    "  --log-bg: #f8f6f1; --shadow: 0 2px 6px rgba(0, 0, 0, .3); }",
    ".screen { background: #000000; color: #c39e6d; border-bottom: 3px solid #c39e6d; }",
    ".bar { color: #000000; } .bar .tag { color: #000000; }",
    ".bar button { background: #000000; color: #c39e6d; }"
  ]
}
