{
  "name": "Clippers",
  "label": "Clippers",
  "order": 80,
  "extends": "../theme.default.json",
  "description": "Red, white and blue.",
  "css": [
    ":root { color-scheme: light; --bg: #1d428a; --panel: #ffffff; --text: #0e1f3f; --muted: #5a6b8c; --line: #d6deec;",
    "  --accent: #1d428a; --accent-text: #ffffff; --ok: #1f8a4c; --warn: #b26a00; --bad: #c8102e; --bar: #c8102e;",
    "  --log-bg: #f4f6fb; --shadow: 0 2px 6px rgba(0, 0, 0, .25); }",
    ".screen { background: #ffffff; color: #1d428a; border-bottom: 3px solid #c8102e; }",
    ".bar { color: #ffffff; } .bar .tag { color: rgba(255, 255, 255, .85); }",
    ".bar button { background: #ffffff; color: #1d428a; }"
  ]
}
