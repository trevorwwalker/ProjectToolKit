# Build intermediates and results; see docs/conventions.md. build/ can be deleted at any time.
build/
out/*
cmake-build-*/

# out/<platform>/ must exist in a clone, so it keeps a committed .gitkeep: out/ is ignored a level down,
# and each platform folder's contents are ignored except its placeholder (see docs/conventions.md).
!out/*/
out/*/*
!out/*/.gitkeep

# Switchyard's dated log and the planner's outbox (card changes a planner could not push) are local.
jobs/.logs/
jobs/.planner-outbox/

# Compiled and generated binaries, wherever they land (bin/ keeps the project's scripts committed;
# the tools built from code/tools/ that land beside them are not).
*.exe
*.dll
*.so
*.dylib
*.obj
*.o
*.a
*.lib
*.pdb
*.ilk

# .NET build output. A project's top-level bin/ holds scripts that are committed, so the .NET
# folders are ignored only under the source trees.
code/**/bin/
code/**/obj/
test/**/bin/
test/**/obj/

# Generated content. The generators live in code/tools/ and their output is rebuilt, not
# hand-committed.
assets/generated/

# Test scratch. Golden files under test/data/ are committed; runs are not.
test/out/
*.tmp

# Editor and tooling
.vs/
.vscode/
.idea/
*.user
*.userprefs
.cache/
compile_commands.json
